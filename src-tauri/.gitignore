# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/

# Speech engine binaries fetched by scripts/fetch-whisper.ps1. Not source: the
# release is a download, so committing it would bloat every clone. Run the
# script before building a release — build-msix.ps1 fails without it.
whisper-bin/

# Scratch icon produced by scripts/generate-icons.ps1 while trimming.
icons/taskbar-source.png

# MSIX / signing byproducts if ever written outside target/
*.msix
*.cer
*.pfx
msix-stage/
