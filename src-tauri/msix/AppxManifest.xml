<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 desktop rescap">
  <Identity Name="PLACEHOLDER" Publisher="PLACEHOLDER" Version="1.0.0.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Flunkey</DisplayName>
    <PublisherDisplayName>Rohan Sharvesh</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Applications>
    <Application Id="Flunkey" Executable="flunkey.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Flunkey" Description="Voice-activated AI assistant for Windows"
        BackgroundColor="#141413" Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <desktop:Extension Category="windows.fullTrustProcess" Executable="flunkey.exe" />
        <uap5:Extension Category="windows.startupTask" Executable="flunkey.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="FlunkeyStartup" Enabled="false" DisplayName="Flunkey" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
    <DeviceCapability Name="microphone" />
  </Capabilities>
</Package>